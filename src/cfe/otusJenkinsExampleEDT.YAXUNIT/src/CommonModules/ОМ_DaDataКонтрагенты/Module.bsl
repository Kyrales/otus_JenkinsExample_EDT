Процедура ПроверкаПочтыТолькоПослеИзменения(Вариант) Экспорт
    Контрагент = НовыйКонтрагентДляТеста();
    Контрагент.ЭлектроннаяПочта = " old@example.org ";
    Данные = Новый Структура;
    Разрешенные = СтрРазделить("ЭлектроннаяПочта", ",");
    Если Вариант <> "missing" Тогда
        Данные.Вставить("ЭлектроннаяПочта", "new@example.org");
    КонецЕсли;
    Если Вариант = "denied" Тогда
        Разрешенные.Очистить();
    ИначеЕсли Вариант = "overlength" Тогда
        ЗначениеПочты = "";
        Для Номер = 1 По 255 Цикл
            ЗначениеПочты = ЗначениеПочты + "x";
        КонецЦикла;
        Данные.Вставить("ЭлектроннаяПочта", ЗначениеПочты);
    КонецЕсли;
    Результат = УспешныйРезультатДляТеста(Данные);
    DaDataКонтрагенты.ПрименитьДанные(Контрагент, Результат, Разрешенные);
    ПочтаИзменена = Неопределено;
    ЕстьПризнак = Результат.Свойство("ПочтаИзменена", ПочтаИзменена);
    ЮТест.ОжидаетЧто(ЕстьПризнак).Равно(Истина);
    ЮТест.ОжидаетЧто(ПочтаИзменена).Равно(Вариант = "applied");
    Если Вариант = "applied" Тогда
        ЮТест.ОжидаетЧто(Контрагент.ЭлектроннаяПочта).Равно("new@example.org");
    Иначе
        ЮТест.ОжидаетЧто(Контрагент.ЭлектроннаяПочта).Равно(" old@example.org ");
    КонецЕсли;
КонецПроцедуры

// Приемочная проверка реальных прав конфигурации в тестовой информационной базе.
Процедура ПраваDaData() Экспорт
    Настройка = Метаданные.Константы.ПутьКФайлуНастроекDaData;
    Контрагенты = Метаданные.Справочники.Контрагенты;
    Для Каждого ИмяРоли Из СтрРазделить("Администратор,МенеджерПоЗакупкам,МенеджерПоПродажам,Продавец", ",") Цикл
        Роль = Метаданные.Роли[ИмяРоли];
        ЮТест.ОжидаетЧто(ПравоДоступа("Чтение", Настройка, Роль)).Равно(Истина);
        ЮТест.ОжидаетЧто(ПравоДоступа("Изменение", Настройка, Роль)).Равно(ИмяРоли = "Администратор");
        ЮТест.ОжидаетЧто(ПравоДоступа("Редактирование", Контрагенты, Роль)).Равно(ИмяРоли <> "Продавец");
    КонецЦикла;
    Роль = Метаданные.Роли.Продавец;
    Для Каждого ИмяПоля Из СтрРазделить("Регион,Телефон,ЭлектроннаяПочта", ",") Цикл
        ЮТест.ОжидаетЧто(ПравоДоступа("Редактирование", Контрагенты.Реквизиты[ИмяПоля], Роль)).Равно(Ложь);
    КонецЦикла;
КонецПроцедуры
