Процедура ПроверитьБезопаснуюОшибку(Результат, КодОшибки)
    ЮТест.ОжидаетЧто(Результат.Успех).Равно(Ложь);
    ЮТест.ОжидаетЧто(Результат.КодОшибки).Равно(КодОшибки);
    ЮТест.ОжидаетЧто(Результат.Данные.Количество()).Равно(0);
    ТекстДляПроверки = Результат.Сообщение + СтрСоединить(Результат.Предупреждения, " ");
    ЮТест.ОжидаетЧто(СтрНайти(ТекстДляПроверки, "unit-secret-marker")).Равно(0);
    ЮТест.ОжидаетЧто(СтрНайти(ТекстДляПроверки, "unit-token")).Равно(0);
    ЮТест.ОжидаетЧто(СтрНайти(ТекстДляПроверки, "TLS timeout")).Равно(0);
КонецПроцедуры

// Отдельная интеграционная проверка, не регистрируется в обычном наборе.
Процедура РеальныйHTTPS(ИНН = "7707083893", ОжидаетсяОрганизация = Истина, ОжидаемыйКодОшибки = "NOT_FOUND") Экспорт
    Путь = "F:\1C\Projects\otus_JenkinsExample_EDT\.env";
    Константы.ПутьКФайлуНастроекDaData.Установить(Путь);
    ЮТест.ОжидаетЧто(Константы.ПутьКФайлуНастроекDaData.Получить()).Равно(Путь);
    Результат = DaDataКонтрагенты.ПолучитьДанные(ИНН, Константы.ПутьКФайлуНастроекDaData.Получить());
    Если ИНН = "784806113663" И Результат.КодОшибки = "INVALID_RESPONSE" Тогда
        Токен = DaDataКонтрагенты.ПрочитатьКлюч(Путь);
        ОтветHTTP = DaDataКонтрагенты.ОтправитьЗапрос(DaDataКонтрагенты.СоздатьЗапрос(ИНН, Токен));
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(ОтветHTTP.Тело);
        ОтветJSON = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        ЮТест.ОжидаетЧто(ОтветJSON.suggestions.Количество()).Равно(2);
        Для Каждого Предложение Из ОтветJSON.suggestions Цикл
            ЮТест.ОжидаетЧто(Предложение.data.inn).Равно(ИНН);
            ЮТест.ОжидаетЧто(Предложение.data.type).Равно("INDIVIDUAL");
        КонецЦикла;
    КонецЕсли;
    Если ОжидаетсяОрганизация Тогда
        ЮТест.ОжидаетЧто(Результат.КодОшибки).Равно("");
    КонецЕсли;
    ЮТест.ОжидаетЧто(Результат.Успех).Равно(ОжидаетсяОрганизация);
    Если Не ОжидаетсяОрганизация Тогда
        ЮТест.ОжидаетЧто(Результат.КодОшибки).Равно(ОжидаемыйКодОшибки);
        ЮТест.ОжидаетЧто(Результат.Данные.Количество()).Равно(0);
        Возврат;
    КонецЕсли;
    ЮТест.ОжидаетЧто(Результат.КодОшибки).Равно("");
    ЮТест.ОжидаетЧто(Результат.Данные.ИНН).Равно(ИНН);
    ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Результат.Данные.Наименование)).Равно(Истина);
    Контрагент = НовыйКонтрагентДляТеста();
    Контрагент.ЭлектроннаяПочта = "old@example.org";
    Разрешенные = СтрРазделить("ИНН,Наименование,Индекс,Страна,Город,Улица,Дом,Телефон,ЭлектроннаяПочта,ВебСайт,КонтактноеЛицо,Широта,Долгота", ",");
    DaDataКонтрагенты.ПрименитьДанные(Контрагент, Результат, Разрешенные);
    ЮТест.ОжидаетЧто(Контрагент.Ссылка.Пустая()).Равно(Истина);
    Если Не Результат.Данные.Свойство("ЭлектроннаяПочта") Тогда
        ЮТест.ОжидаетЧто(Контрагент.ЭлектроннаяПочта).Равно("old@example.org");
    КонецЕсли;
    // Внешний HTTP уже завершен: транзакция используется только для отката тестовой записи.
    НачатьТранзакцию();
    Попытка
        Контрагент.Записать();
        Ссылка = Контрагент.Ссылка;
        Прочитанный = Ссылка.ПолучитьОбъект();
        ЮТест.ОжидаетЧто(Прочитанный.ИНН).Равно(ИНН);
        ЮТест.ОжидаетЧто(Прочитанный.Наименование).Равно(Контрагент.Наименование);
        ОтменитьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

