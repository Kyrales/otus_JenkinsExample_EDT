Процедура ЧтениеКлючаИзФайла() Экспорт
    Путь = ПолучитьИмяВременногоФайла("env");
    Попытка
        Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
        Запись.ЗаписатьСтроку("dadata=unit-token");
        Запись.Закрыть();
        Ключ = DaDataКонтрагенты.ПрочитатьКлюч(Путь);
        УдалитьФайлы(Путь);
    Исключение
        УдалитьФайлы(Путь);
        ВызватьИсключение;
    КонецПопытки;
    ЮТест.ОжидаетЧто(Ключ).Равно("unit-token");
    ФайлНастроек = Новый Файл(Путь);
    ЮТест.ОжидаетЧто(ФайлНастроек.Существует()).Равно(Ложь);
КонецПроцедуры

Процедура ОшибкаЧтенияКлюча() Экспорт
    Пути = Новый Массив;
    Пути.Добавить("");
    Пути.Добавить("relative.env");
    Пути.Добавить("C:relative.env");
    Пути.Добавить(ПолучитьИмяВременногоФайла("missing-env"));
    Для Каждого Путь Из Пути Цикл
        ПолученаОшибка = Ложь;
        Попытка
            DaDataКонтрагенты.ПрочитатьКлюч(Путь);
        Исключение
            ПолученаОшибка = Истина;
        КонецПопытки;
        ЮТест.ОжидаетЧто(ПолученаОшибка).Равно(Истина);
    КонецЦикла;
КонецПроцедуры

