Процедура ПроверитьЗапрос(ИНН, ВидОрганизации)
    Запрос = DaDataКонтрагенты.СоздатьЗапрос(ИНН, "unit-token");
    ЮТест.ОжидаетЧто(Запрос.АдресРесурса).Равно("/suggestions/api/4_1/rs/findById/party");
    ЮТест.ОжидаетЧто(Запрос.Заголовки.Получить("Content-Type")).Равно("application/json");
    ЮТест.ОжидаетЧто(Запрос.Заголовки.Получить("Accept")).Равно("application/json");
    ЮТест.ОжидаетЧто(Запрос.Заголовки.Получить("Authorization")).Равно("Token unit-token");
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    ЮТест.ОжидаетЧто(Данные.query).Равно(ИНН);
    ЮТест.ОжидаетЧто(Данные.branch_type).Равно("MAIN");
    ЮТест.ОжидаетЧто(Данные.count).Равно(10);
    ЮТест.ОжидаетЧто(Данные.type).Равно(ВидОрганизации);
КонецПроцедуры

