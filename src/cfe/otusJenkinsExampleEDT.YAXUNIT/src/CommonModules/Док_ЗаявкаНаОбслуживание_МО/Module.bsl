#Область СлужебныйПрограммныйИнтерфейс

// Регистрирует сценарии проверки документа ЗаявкаНаОбслуживание.
Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты.ДобавитьТестовыйНабор("Документ Заявка на обслуживание").ВТранзакции()
		.ДобавитьТест("ПередЗаписью")
			.СПараметрами("ЗаполняетСтатусНовая")
			.СПараметрами("СохраняетУказанныйСтатус")
			.СПараметрами("НеЗаписываетБезКонтрагента")
			.СПараметрами("НеЗаписываетБезОписанияПроблемы")
			.СПараметрами("НеЗаписываетСПустымОписаниемПроблемы")
			.СПараметрами("ЗаписываетКорректнуюЗаявку")
			.СПараметрами("НеПроводитЗаявкуПриЗаписи")
			.СПараметрами("ДанныеЗаявкиДоступныДляОтчета")
		.ДобавитьТест("СтатусыЗаявокНаОбслуживаниеЗаполнены")
		;

КонецПроцедуры

// Проверяет запись заявки на обслуживание и серверную валидацию обработчика ПередЗаписью.
//
// Параметры:
//  Сценарий - Строка - Имя проверяемого сценария.
Процедура ПередЗаписью(Сценарий) Экспорт

	Если Сценарий = "ЗаполняетСтатусНовая" Тогда
		ПроверитьЗаполнениеСтатусаНовая();
	ИначеЕсли Сценарий = "СохраняетУказанныйСтатус" Тогда
		ПроверитьСохранениеУказанногоСтатуса();
	ИначеЕсли Сценарий = "НеЗаписываетБезКонтрагента" Тогда
		ПроверитьОтказЗаписиБезКонтрагента();
	ИначеЕсли Сценарий = "НеЗаписываетБезОписанияПроблемы" Тогда
		ПроверитьОтказЗаписиБезОписанияПроблемы();
	ИначеЕсли Сценарий = "НеЗаписываетСПустымОписаниемПроблемы" Тогда
		ПроверитьОтказЗаписиСПустымОписаниемПроблемы();
	ИначеЕсли Сценарий = "ЗаписываетКорректнуюЗаявку" Тогда
		ПроверитьЗаписьКорректнойЗаявки();
	ИначеЕсли Сценарий = "НеПроводитЗаявкуПриЗаписи" Тогда
		ПроверитьЧтоЗаявкаНеПроводитсяПриЗаписи();
	ИначеЕсли Сценарий = "ДанныеЗаявкиДоступныДляОтчета" Тогда
		ПроверитьДанныеЗаявкиДляОтчета();
	КонецЕсли;

КонецПроцедуры

// Проверяет наличие всех значений перечисления статусов заявок на обслуживание.
Процедура СтатусыЗаявокНаОбслуживаниеЗаполнены() Экспорт

	ЮТест.ОжидаетЧто(Перечисления.СтатусыЗаявокНаОбслуживание.Новая, "Статус Новая")
		.Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыЗаявокНаОбслуживание.ВРаботе, "Статус В работе")
		.Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыЗаявокНаОбслуживание.Выполнена, "Статус Выполнена")
		.Заполнено();
	ЮТест.ОжидаетЧто(Перечисления.СтатусыЗаявокНаОбслуживание.Отменена, "Статус Отменена")
		.Заполнено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеСтатусаНовая()

	Заявка = НоваяЗаявка();
	Заявка.Контрагент = СоздатьКонтрагента();
	Заявка.ОписаниеПроблемы = ТестовоеОписаниеПроблемы();

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.НеВыбрасываетИсключение();
	ЮТест.ОжидаетЧто(Заявка.Статус, "Статус новой заявки")
		.Равно(Перечисления.СтатусыЗаявокНаОбслуживание.Новая);

КонецПроцедуры

Процедура ПроверитьСохранениеУказанногоСтатуса()

	Заявка = НоваяЗаявка();
	Заявка.Контрагент = СоздатьКонтрагента();
	Заявка.ОписаниеПроблемы = ТестовоеОписаниеПроблемы();
	Заявка.Статус = Перечисления.СтатусыЗаявокНаОбслуживание.ВРаботе;

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.НеВыбрасываетИсключение();
	ЮТест.ОжидаетЧто(Заявка.Статус, "Указанный статус заявки")
		.Равно(Перечисления.СтатусыЗаявокНаОбслуживание.ВРаботе);

КонецПроцедуры

Процедура ПроверитьОтказЗаписиБезКонтрагента()

	Заявка = НоваяЗаявка();
	Заявка.ОписаниеПроблемы = ТестовоеОписаниеПроблемы();

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.ВыбрасываетИсключение("Не удалось записать");
	ЮТест.ОжидаетЧто(Заявка.Ссылка, "Ссылка незаписанной заявки")
		.НеЗаполнено();

КонецПроцедуры

Процедура ПроверитьОтказЗаписиБезОписанияПроблемы()

	Заявка = НоваяЗаявка();
	Заявка.Контрагент = СоздатьКонтрагента();

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.ВыбрасываетИсключение("Не удалось записать");
	ЮТест.ОжидаетЧто(Заявка.Ссылка, "Ссылка незаписанной заявки")
		.НеЗаполнено();

КонецПроцедуры

Процедура ПроверитьОтказЗаписиСПустымОписаниемПроблемы()

	Заявка = НоваяЗаявка();
	Заявка.Контрагент = СоздатьКонтрагента();
	Заявка.ОписаниеПроблемы = "";

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.ВыбрасываетИсключение("Не удалось записать");
	ЮТест.ОжидаетЧто(Заявка.Ссылка, "Ссылка незаписанной заявки")
		.НеЗаполнено();

КонецПроцедуры

Процедура ПроверитьЗаписьКорректнойЗаявки()

	Заявка = НоваяЗаявка();
	Контрагент = СоздатьКонтрагента();
	ОписаниеПроблемы = ТестовоеОписаниеПроблемы();
	Заявка.Контрагент = Контрагент;
	Заявка.ОписаниеПроблемы = ОписаниеПроблемы;

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.НеВыбрасываетИсключение();
	ЮТест.ОжидаетЧто(Заявка.Ссылка, "Ссылка записанной заявки")
		.Заполнено()
		.ИмеетТип("ДокументСсылка.ЗаявкаНаОбслуживание");
	ЮТест.ОжидаетЧто(Заявка.Контрагент, "Контрагент заявки")
		.Равно(Контрагент);
	ЮТест.ОжидаетЧто(Заявка.ОписаниеПроблемы, "Описание проблемы")
		.Равно(ОписаниеПроблемы);

КонецПроцедуры

Процедура ПроверитьЧтоЗаявкаНеПроводитсяПриЗаписи()

	Заявка = НоваяЗаявка();
	Заявка.Контрагент = СоздатьКонтрагента();
	Заявка.ОписаниеПроблемы = ТестовоеОписаниеПроблемы();

	ЮТест.ОжидаетЧто(Заявка)
		.Метод("Записать")
		.НеВыбрасываетИсключение();
	ЮТест.ОжидаетЧто(Заявка.Проведен, "Признак проведения заявки")
		.ЭтоЛожь();

КонецПроцедуры

Процедура ПроверитьДанныеЗаявкиДляОтчета()

	Заявка = НоваяЗаявка();
	Контрагент = СоздатьКонтрагента();
	ОписаниеПроблемы = ТестовоеОписаниеПроблемы();
	Заявка.Контрагент = Контрагент;
	Заявка.ОписаниеПроблемы = ОписаниеПроблемы;
	Заявка.Записать();

	Выборка = ВыбратьДанныеЗаявкиДляОтчета(Заявка.Ссылка);

	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Запись заявки в данных отчета")
		.ЭтоИстина();
	ЮТест.ОжидаетЧто(Выборка.Номер, "Номер заявки в отчете")
		.Равно(Заявка.Номер);
	ЮТест.ОжидаетЧто(Выборка.Контрагент, "Контрагент заявки в отчете")
		.Равно(Контрагент);
	ЮТест.ОжидаетЧто(Выборка.ОписаниеПроблемы, "Описание проблемы в отчете")
		.Равно(ОписаниеПроблемы);
	ЮТест.ОжидаетЧто(Выборка.Статус, "Статус заявки в отчете")
		.Равно(Перечисления.СтатусыЗаявокНаОбслуживание.Новая);
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Единственная запись заявки в данных отчета")
		.ЭтоЛожь();

КонецПроцедуры

Функция НоваяЗаявка()

	Возврат ЮТест.Данные().КонструкторОбъекта("Документы.ЗаявкаНаОбслуживание")
		.Установить("Дата", ТекущаяДатаСеанса())
		.НовыйОбъект();

КонецФункции

Функция СоздатьКонтрагента()

	Наименование = "Тестовый контрагент " + ЮТест.Данные().СлучайнаяСтрока();

	Возврат ЮТест.Данные().КонструкторОбъекта("Справочники.Контрагенты")
		.Установить("Наименование", Наименование)
		.Записать();

КонецФункции

Функция ТестовоеОписаниеПроблемы()

	Возврат "Тестовое описание проблемы " + ЮТест.Данные().СлучайнаяСтрока();

КонецФункции

Функция ВыбратьДанныеЗаявкиДляОтчета(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|   ЗаявкиНаОбслуживание.Номер КАК Номер,
		|   ЗаявкиНаОбслуживание.Дата КАК Дата,
		|   ЗаявкиНаОбслуживание.Контрагент КАК Контрагент,
		|   ЗаявкиНаОбслуживание.ОписаниеПроблемы КАК ОписаниеПроблемы,
		|   ЗаявкиНаОбслуживание.Статус КАК Статус
		|ИЗ
		|   Документ.ЗаявкаНаОбслуживание КАК ЗаявкиНаОбслуживание
		|ГДЕ
		|   ЗаявкиНаОбслуживание.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

#КонецОбласти
