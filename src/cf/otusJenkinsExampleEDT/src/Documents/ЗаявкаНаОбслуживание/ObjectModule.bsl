#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыЗаявокНаОбслуживание.Новая;
	КонецЕсли;

	ПроверитьЗаполнениеЗаявки(Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЗаполнениеЗаявки(Отказ)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		СообщитьПользователюОбОшибке(
			НСтр("ru = 'Не заполнен контрагент.'"),
			"Контрагент");
		Отказ = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОписаниеПроблемы) Тогда
		СообщитьПользователюОбОшибке(
			НСтр("ru = 'Не заполнено описание проблемы.'"),
			"ОписаниеПроблемы");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьПользователюОбОшибке(ТекстСообщения, ИмяПоля)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Поле = ИмяПоля;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти
