#Область ПрограммныйИнтерфейс

// Проверяет и нормализует ИНН.
// Параметры:
//  ИНН - Строка - Входной ИНН.
// Возвращаемое значение:
//  Строка - Проверенный ИНН.
Функция НормализоватьИНН(ИНН) Экспорт
    Если ТипЗнч(ИНН) <> Тип("Строка") Тогда
        ВызватьИсключение НСтр("ru = 'Введите ИНН из 10 или 12 цифр.'");
    КонецЕсли;
    Результат = СокрЛП(ИНН);
    Длина = СтрДлина(Результат);
    Если Длина <> 10 И Длина <> 12 Тогда
        ВызватьИсключение НСтр("ru = 'Введите ИНН из 10 или 12 цифр.'");
    КонецЕсли;
    Для Индекс = 1 По Длина Цикл
        Если СтрНайти("0123456789", Сред(Результат, Индекс, 1)) = 0 Тогда
            ВызватьИсключение НСтр("ru = 'ИНН должен содержать только цифры.'");
        КонецЕсли;
    КонецЦикла;
    Если Длина = 10 Тогда
        Коэффициенты = СтрРазделить("2,4,10,3,5,9,4,6,8", ",");
        КонтрольныеПозиции = СтрРазделить("10", ",");
    Иначе
        Коэффициенты = СтрРазделить("7,2,4,10,3,5,9,4,6,8", ",");
        КонтрольныеПозиции = СтрРазделить("11,12", ",");
    КонецЕсли;
    Для Каждого Позиция Из КонтрольныеПозиции Цикл
        КонтрольнаяПозиция = Число(Позиция);
        Если КонтрольнаяПозиция = 12 Тогда
            Коэффициенты = СтрРазделить("3,7,2,4,10,3,5,9,4,6,8", ",");
        КонецЕсли;
        Сумма = 0;
        Для Индекс = 1 По КонтрольнаяПозиция - 1 Цикл
            Сумма = Сумма + Число(Сред(Результат, Индекс, 1)) * Число(Коэффициенты[Индекс - 1]);
        КонецЦикла;
        Если (Сумма % 11) % 10 <> Число(Сред(Результат, КонтрольнаяПозиция, 1)) Тогда
            ВызватьИсключение НСтр("ru = 'Неверные контрольные цифры ИНН.'");
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

#КонецОбласти

Функция КлючИзТекстаНастроек(Текст) Экспорт
    Найден = Ложь;
    Ключ = "";
    Если Лев(Текст, 1) = Символ(65279) Тогда
        Текст = Сред(Текст, 2);
    КонецЕсли;
    СтрокиНастроек = СтрРазделить(СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС), Символы.ПС, Истина);
    Для Каждого СтрокаНастроек Из СтрокиНастроек Цикл
        СтрокаНастроек = СокрЛП(СтрокаНастроек);
        Если Лев(СтрокаНастроек, 1) = "#" Тогда
            Продолжить;
        КонецЕсли;
        Если Лев(СтрокаНастроек, 7) = "export " Тогда
            СтрокаНастроек = СокрЛП(Сред(СтрокаНастроек, 8));
        КонецЕсли;
        Разделитель = СтрНайти(СтрокаНастроек, "=");
        Если Разделитель = 0 Тогда
            Продолжить;
        КонецЕсли;
        Если СокрЛП(Лев(СтрокаНастроек, Разделитель - 1)) <> "dadata" Тогда
            Продолжить;
        КонецЕсли;
        Если Найден Тогда
            ВызватьИсключение НСтр("ru = 'В настройках DaData повторяется переменная dadata.'");
        КонецЕсли;
        Найден = Истина;
        Ключ = СокрЛП(Сред(СтрокаНастроек, Разделитель + 1));
        ПерваяБуква = Лев(Ключ, 1);
        Если ПерваяБуква = "'" Или ПерваяБуква = """" Тогда
            Если СтрДлина(Ключ) < 2 Или Прав(Ключ, 1) <> ПерваяБуква Тогда
                ВызватьИсключение НСтр("ru = 'Неверный формат ключа DaData.'");
            КонецЕсли;
            Ключ = Сред(Ключ, 2, СтрДлина(Ключ) - 2);
            Если СтрНайти(Ключ, ПерваяБуква) > 0 Тогда
                ВызватьИсключение НСтр("ru = 'Неверный формат ключа DaData.'");
            КонецЕсли;
        КонецЕсли;
        Если СтрНайти(Ключ, Символы.ВК) > 0 Или СтрНайти(Ключ, Символы.ПС) > 0 Тогда
            ВызватьИсключение НСтр("ru = 'Неверный формат ключа DaData.'");
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Ключ) Тогда
            ВызватьИсключение НСтр("ru = 'В настройках не указан ключ DaData.'");
        КонецЕсли;
    КонецЦикла;
    Если Не Найден Тогда
        ВызватьИсключение НСтр("ru = 'В настройках не указана переменная dadata.'");
    КонецЕсли;
    Возврат Ключ;
КонецФункции

Функция ПрочитатьКлюч(Путь) Экспорт
    Если ТипЗнч(Путь) <> Тип("Строка") Или Не ЗначениеЗаполнено(Путь) Тогда
        ВызватьИсключение НСтр("ru = 'Укажите абсолютный путь к файлу настроек DaData.'");
    КонецЕсли;
    Если Сред(Путь, 2, 1) <> ":" И Лев(Путь, 1) <> "/" И Лев(Путь, 2) <> "\\" Тогда
        ВызватьИсключение НСтр("ru = 'Укажите абсолютный путь к файлу настроек DaData.'");
    КонецЕсли;
    Чтение = Неопределено;
    Попытка
        Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8, , , Истина);
        Текст = Чтение.Прочитать();
        Чтение.Закрыть();
    Исключение
        Если Чтение <> Неопределено Тогда
            Чтение.Закрыть();
        КонецЕсли;
        ВызватьИсключение НСтр("ru = 'Не удалось прочитать файл настроек DaData.'");
    КонецПопытки;
    Возврат КлючИзТекстаНастроек(Текст);
КонецФункции

// Создает HTTP-запрос DaData.
// Параметры:
//  ИНН - Строка - Проверенный ИНН.
//  Ключ - Строка - API-ключ.
// Возвращаемое значение:
//  HTTPЗапрос - Готовый запрос.
Функция СоздатьЗапрос(ИНН, Ключ) Экспорт
    ВидОрганизации = ?(СтрДлина(ИНН) = 10, "LEGAL", "INDIVIDUAL");
    Данные = Новый Структура("query,branch_type,count,type", ИНН, "MAIN", 10, ВидОрганизации);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Accept", "application/json");
    Заголовки.Вставить("Authorization", "Token " + Ключ);
    Запрос = Новый HTTPЗапрос("/suggestions/api/4_1/rs/findById/party", Заголовки);
    Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Возврат Запрос;
КонецФункции

// Преобразует ответ DaData в структуру результата.
// Параметры:
//  КодHTTP - Число - Код ответа.
//  Тело - Строка - JSON ответа.
//  ИНН - Строка - ИНН запроса.
// Возвращаемое значение:
//  Структура - Результат с данными и предупреждениями.
Функция РазобратьОтвет(КодHTTP, Тело, ИНН) Экспорт
    Если КодHTTP <> 200 Тогда
        Если КодHTTP = 401 Или КодHTTP = 403 Тогда
            Возврат ОшибкаDaData("ACCESS_DENIED");
        ИначеЕсли КодHTTP = 429 Тогда
            Возврат ОшибкаDaData("RATE_LIMIT");
        ИначеЕсли КодHTTP >= 500 Тогда
            Возврат ОшибкаDaData("SERVICE_ERROR");
        Иначе
            Возврат ОшибкаDaData("HTTP_ERROR");
        КонецЕсли;
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Попытка
        Чтение.УстановитьСтроку(Тело);
        Ответ = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Чтение.Закрыть();
        Возврат ОшибкаDaData("INVALID_RESPONSE");
    КонецПопытки;
    Предложения = Неопределено;
    Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
        Возврат ОшибкаDaData("INVALID_RESPONSE");
    КонецЕсли;
    Если Не Ответ.Свойство("suggestions", Предложения) Или ТипЗнч(Предложения) <> Тип("Массив") Тогда
        Возврат ОшибкаDaData("INVALID_RESPONSE");
    КонецЕсли;
    Если Предложения.Количество() = 0 Тогда
        Возврат ОшибкаDaData("NOT_FOUND");
    КонецЕсли;
    Подходящие = Новый Массив;
    ЕстьИНН = Ложь;
    Для Каждого Предложение Из Предложения Цикл
        Организация = Неопределено;
        Если ТипЗнч(Предложение) <> Тип("Структура") Тогда
            Возврат ОшибкаDaData("INVALID_RESPONSE");
        КонецЕсли;
        Если Не Предложение.Свойство("data", Организация) Или ТипЗнч(Организация) <> Тип("Структура") Тогда
            Возврат ОшибкаDaData("INVALID_RESPONSE");
        КонецЕсли;
        ИННОтвета = Неопределено;
        ВидОрганизации = Неопределено;
        Если Не Организация.Свойство("inn", ИННОтвета) Или Не Организация.Свойство("type", ВидОрганизации) Тогда
            Возврат ОшибкаDaData("INVALID_RESPONSE");
        КонецЕсли;
        Если ИННОтвета <> ИНН Тогда
            Возврат ОшибкаDaData("INVALID_RESPONSE");
        КонецЕсли;
        ЕстьИНН = Истина;
        Если СтрДлина(ИНН) = 10 Тогда
            ВидОтделения = Неопределено;
            Если Не Организация.Свойство("branch_type", ВидОтделения) Тогда
                Возврат ОшибкаDaData("INVALID_RESPONSE");
            КонецЕсли;
            Если ВидОрганизации <> "LEGAL" Или ВидОтделения <> "MAIN" Тогда
                Продолжить;
            КонецЕсли;
        ИначеЕсли ВидОрганизации <> "INDIVIDUAL" Тогда
            Продолжить;
        КонецЕсли;
        Подходящие.Добавить(Предложение);
    КонецЦикла;
    Если Не ЕстьИНН Или Подходящие.Количество() > 1 Тогда
        Возврат ОшибкаDaData("INVALID_RESPONSE");
    КонецЕсли;
    Если Подходящие.Количество() = 0 Тогда
        Возврат ОшибкаDaData("NOT_FOUND");
    КонецЕсли;
    Организация = Подходящие[0].data;
    Результат = ОшибкаDaData("");
    Данные = Результат.Данные;
    Предупреждения = Результат.Предупреждения;
    Данные.Вставить("ИНН", Организация.inn);
    Название = ПерваяСтрока(Организация, "name.short_with_opf,name.full_with_opf", Предупреждения);
    Если Не ЗначениеЗаполнено(Название) Тогда
        Название = ПерваяСтрока(Подходящие[0], "value", Предупреждения);
    КонецЕсли;
    ВставитьСтроку(Данные, "Наименование", Название, Предупреждения);
    Адрес = ЗначениеПути(Организация, "address.data", Предупреждения);
    ПоляАдреса = Новый Структура("Индекс,Страна,Улица", "postal_code", "country", "street_with_type");
    Для Каждого Поле Из ПоляАдреса Цикл
        ВставитьСтроку(Данные, Поле.Ключ, ЗначениеПути(Адрес, Поле.Значение, Предупреждения), Предупреждения);
    КонецЦикла;
    ВставитьСтроку(Данные, "Город", ПерваяСтрока(Адрес, "city_with_type,settlement_with_type", Предупреждения), Предупреждения);
    ЧастиДома = Новый Массив;
    Для Каждого ВидЧасти Из СтрРазделить("house,block,building", ",") Цикл
        Номер = ПерваяСтрока(Адрес, ВидЧасти, Предупреждения);
        Если ЗначениеЗаполнено(Номер) Тогда
            Вид = ПерваяСтрока(Адрес, ВидЧасти + "_type", Предупреждения);
            Если ВидЧасти = "house" И Не ЗначениеЗаполнено(Вид) Тогда
                Вид = "д.";
            КонецЕсли;
            ЧастиДома.Добавить(СокрЛП(Вид + " " + Номер));
        КонецЕсли;
    КонецЦикла;
    ВставитьСтроку(Данные, "Дом", СтрСоединить(ЧастиДома, ", "), Предупреждения);
    ВставитьКоординату(Данные, "Широта", ЗначениеПути(Адрес, "geo_lat", Предупреждения), 90, Предупреждения);
    ВставитьКоординату(Данные, "Долгота", ЗначениеПути(Адрес, "geo_lon", Предупреждения), 180, Предупреждения);
    Телефоны = ЗначениеПути(Организация, "phones", Предупреждения);
    ВставитьСтроку(Данные, "Телефон", ПервыйКонтакт(Телефоны, "value", "data.source", Предупреждения), Предупреждения);
    ВставитьСтроку(Данные, "ЭлектроннаяПочта",
        ПервыйКонтакт(ЗначениеПути(Организация, "emails", Предупреждения), "value", "data.source", Предупреждения), Предупреждения);
    ВставитьСтроку(Данные, "ВебСайт",
        ПервыйКонтакт(ЗначениеПути(Организация, "sites", Предупреждения), "value", "data.domain", Предупреждения), Предупреждения);
    Контакт = ПерваяСтрока(Организация, "management.name", Предупреждения);
    Если Не ЗначениеЗаполнено(Контакт) Тогда
        Контакт = ПервыйКонтакт(Телефоны, "data.contact", "", Предупреждения);
    КонецЕсли;
    ВставитьСтроку(Данные, "КонтактноеЛицо", Контакт, Предупреждения);
    Для Каждого ИмяПоля Из СтрРазделить("region_with_type,region", ",") Цикл
        ИмяРегиона = ПерваяСтрока(Адрес, ИмяПоля, Предупреждения);
        Если ЗначениеЗаполнено(ИмяРегиона) Тогда
            Результат.ИменаРегиона.Добавить(ИмяРегиона);
        КонецЕсли;
    КонецЦикла;
    Статус = ПерваяСтрока(Организация, "state.status", Предупреждения);
    Если ЗначениеЗаполнено(Статус) И Статус <> "ACTIVE" Тогда
        Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Статус контрагента в DaData: %1.'"), Статус));
    КонецЕсли;
    Результат.Успех = Истина;
    Возврат Результат;
КонецФункции

Функция ОшибкаDaData(Код)
    Сообщения = Новый Структура;
    Сообщения.Вставить("ACCESS_DENIED", НСтр("ru = 'DaData отклонил доступ. Проверьте API-ключ и доступ к сервису.'"));
    Сообщения.Вставить("RATE_LIMIT", НСтр("ru = 'Достигнут лимит запросов DaData. Повторите позднее.'"));
    Сообщения.Вставить("SERVICE_ERROR", НСтр("ru = 'Сервис DaData временно недоступен.'"));
    Сообщения.Вставить("HTTP_ERROR", НСтр("ru = 'DaData отклонил запрос.'"));
    Сообщения.Вставить("INVALID_RESPONSE", НСтр("ru = 'DaData вернул некорректный или неоднозначный ответ.'"));
    Сообщения.Вставить("NOT_FOUND", НСтр("ru = 'Контрагент по указанному ИНН не найден.'"));
    Сообщения.Вставить("INVALID_INN", НСтр("ru = 'Введите корректный ИНН из 10 или 12 цифр.'"));
    Сообщения.Вставить("SETTINGS_ERROR", НСтр("ru = 'Не удалось прочитать настройки DaData. Обратитесь к администратору.'"));
    Сообщения.Вставить("TRANSPORT_ERROR", НСтр("ru = 'Не удалось связаться с DaData. Проверьте соединение и повторите позднее.'"));
    Сообщение = "";
    Если ЗначениеЗаполнено(Код) Тогда
        Сообщения.Свойство(Код, Сообщение);
    КонецЕсли;
    Возврат Новый Структура("Успех,КодОшибки,Сообщение,Данные,Предупреждения,ИменаРегиона",
        Ложь, Код, Сообщение, Новый Структура, Новый Массив, Новый Массив);
КонецФункции

Функция ЗначениеПути(Узел, Путь, Предупреждения)
    Текущее = Узел;
    Для Каждого Имя Из СтрРазделить(Путь, ".") Цикл
        Если Текущее = Неопределено Или ТипЗнч(Текущее) = Тип("Null") Тогда
            Возврат Неопределено;
        КонецЕсли;
        Если ТипЗнч(Текущее) <> Тип("Структура") Тогда
            Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Не удалось прочитать поле DaData: %1.'"), Путь));
            Возврат Неопределено;
        КонецЕсли;
        Значение = Неопределено;
        Если Не Текущее.Свойство(Имя, Значение) Тогда
            Возврат Неопределено;
        КонецЕсли;
        Текущее = Значение;
    КонецЦикла;
    Возврат Текущее;
КонецФункции

Функция ПерваяСтрока(Узел, Пути, Предупреждения)
    Для Каждого Путь Из СтрРазделить(Пути, ",") Цикл
        Значение = ЗначениеПути(Узел, Путь, Предупреждения);
        Если ТипЗнч(Значение) = Тип("Строка") Тогда
            Если ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
                Возврат СокрЛП(Значение);
            КонецЕсли;
        ИначеЕсли Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Null") Тогда
            Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Неверный тип поля DaData: %1.'"), Путь));
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Процедура ВставитьСтроку(Данные, Имя, Значение, Предупреждения)
    Если ТипЗнч(Значение) = Тип("Строка") Тогда
        Если ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
            Данные.Вставить(Имя, СокрЛП(Значение));
        КонецЕсли;
    ИначеЕсли Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Null") Тогда
        Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Поле %1 пропущено: неверный тип данных.'"), Имя));
    КонецЕсли;
КонецПроцедуры

Функция ПервыйКонтакт(Записи, ОсновнойПуть, РезервныйПуть, Предупреждения)
    Если Записи = Неопределено Или ТипЗнч(Записи) = Тип("Null") Тогда
        Возврат "";
    КонецЕсли;
    Если ТипЗнч(Записи) <> Тип("Массив") Тогда
        Предупреждения.Добавить(НСтр("ru = 'Контактные данные DaData имеют неверный формат.'"));
        Возврат "";
    КонецЕсли;
    Пути = ОсновнойПуть;
    Если ЗначениеЗаполнено(РезервныйПуть) Тогда
        Пути = Пути + "," + РезервныйПуть;
    КонецЕсли;
    Для Каждого Запись Из Записи Цикл
        Значение = ПерваяСтрока(Запись, Пути, Предупреждения);
        Если ЗначениеЗаполнено(Значение) Тогда
            Возврат Значение;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции

Процедура ВставитьКоординату(Данные, Имя, Значение, Предел, Предупреждения)
    Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Или Значение = "" Тогда
        Возврат;
    КонецЕсли;
    Корректно = ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Число");
    Если Корректно Тогда
        Попытка
            Координата = Число(Значение);
            Корректно = Координата >= -Предел И Координата <= Предел;
        Исключение
            Корректно = Ложь;
        КонецПопытки;
    КонецЕсли;
    Если Корректно Тогда
        Данные.Вставить(Имя, Окр(Координата, 6));
    Иначе
        Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Координата %1 пропущена: неверное значение.'"), Имя));
    КонецЕсли;
КонецПроцедуры

// Подбирает только единственную ссылку по нормализованному имени.
Функция НайтиРегион(ИменаРегиона, Кандидаты) Экспорт
    Совпадения = Новый Соответствие;
    Для Каждого Кандидат Из Кандидаты Цикл
        Для Каждого ИмяРегиона Из ИменаРегиона Цикл
            Если ВРег(СокрЛП(Кандидат.Наименование)) = ВРег(СокрЛП(ИмяРегиона))
                И ЗначениеЗаполнено(Кандидат.Ссылка) Тогда
                Совпадения.Вставить(Кандидат.Ссылка, Истина);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Если Совпадения.Количество() = 1 Тогда
        Для Каждого Совпадение Из Совпадения Цикл
            Возврат Совпадение.Ключ;
        КонецЦикла;
    КонецЕсли;
    Возврат Справочники.Регионы.ПустаяСсылка();
КонецФункции

// Изменяет разрешенные поля незаписанного объекта, не сохраняя его в ИБ.
Функция ПрименитьДанные(Контрагент, Результат, РазрешенныеПоля) Экспорт
    Предупреждения = Новый Массив;
    Результат.Вставить("ПочтаИзменена", Ложь);
    Если Не Результат.Успех Тогда
        Возврат Предупреждения;
    КонецЕсли;
    ЦелевыеПоля = СтрРазделить("ИНН,Наименование,Индекс,Страна,Город,Улица,Дом,Регион,Телефон,ЭлектроннаяПочта,ВебСайт,КонтактноеЛицо,Широта,Долгота", ",");
    Для Каждого Поле Из Результат.Данные Цикл
        Если ЦелевыеПоля.Найти(Поле.Ключ) = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Поле.Значение = Неопределено Или Поле.Значение = Null Тогда
            Продолжить;
        КонецЕсли;
        Если ТипЗнч(Поле.Значение) = Тип("Строка") И СокрЛП(Поле.Значение) = "" Тогда
            Продолжить;
        КонецЕсли;
        Если Поле.Ключ = "Регион" И Не ЗначениеЗаполнено(Поле.Значение) Тогда
            Продолжить;
        КонецЕсли;
        Если РазрешенныеПоля.Найти(Поле.Ключ) = Неопределено Тогда
            Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Нет права изменять поле %1.'"), Поле.Ключ));
            Продолжить;
        КонецЕсли;
        Если ТипЗнч(Поле.Значение) = Тип("Строка") Тогда
            Если Поле.Ключ = "Наименование" Тогда
                Предел = Контрагент.Метаданные().ДлинаНаименования;
            Иначе
                Предел = Контрагент.Метаданные().Реквизиты[Поле.Ключ].Тип.КвалификаторыСтроки.Длина;
            КонецЕсли;
            Если Поле.Ключ = "ВебСайт" Тогда
                Предел = 2048;
            КонецЕсли;
            Если Предел > 0 И СтрДлина(Поле.Значение) > Предел Тогда
                Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Поле %1 пропущено: значение превышает допустимую длину.'"), Поле.Ключ));
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        Если Поле.Ключ = "ЭлектроннаяПочта" Тогда
            Результат.ПочтаИзменена = Контрагент.ЭлектроннаяПочта <> Поле.Значение;
        КонецЕсли;
        Контрагент[Поле.Ключ] = Поле.Значение;
    КонецЦикла;
    Возврат Предупреждения;
КонецФункции

// Выполняет проверку входа и настроек перед единственным запросом к сервису.
Функция ПолучитьДанные(ИНН, Путь, Транспорт = Неопределено) Экспорт
    Попытка
        НормализованныйИНН = НормализоватьИНН(ИНН);
    Исключение
        Возврат ОшибкаDaData("INVALID_INN");
    КонецПопытки;
    Попытка
        Ключ = ПрочитатьКлюч(Путь);
    Исключение
        Возврат ОшибкаDaData("SETTINGS_ERROR");
    КонецПопытки;
    Попытка
        Запрос = СоздатьЗапрос(НормализованныйИНН, Ключ);
        Если Транспорт = Неопределено Тогда
            Ответ = ОтправитьЗапрос(Запрос);
        Иначе
            Ответ = Транспорт.ОтправитьЗапрос(Запрос);
        КонецЕсли;
    Исключение
        Возврат ОшибкаDaData("TRANSPORT_ERROR");
    КонецПопытки;
    Возврат РазобратьОтвет(Ответ.КодHTTP, Ответ.Тело, НормализованныйИНН);
КонецФункции

// Отправляет один POST к фиксированному сервису с проверкой TLS.
Функция ОтправитьЗапрос(Запрос) Экспорт
    TLS = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
    Соединение = Новый HTTPСоединение("suggestions.dadata.ru", 443, , , , 15, TLS);
    Ответ = Соединение.ОтправитьДляОбработки(Запрос);
    Возврат Новый Структура("КодHTTP,Тело", Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
КонецФункции
